{
  "name": "headsuptrucker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-maplibre.mjs",
    "predev": "node scripts/prepare-maplibre.mjs",
    "prebuild": "node scripts/prepare-maplibre.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests package.json tsconfig.json README.md data-audit.md docs",
    "test": "tsx --test tests/*.test.ts",
    "data:fetch": "tsx scripts/fetch-sources.ts",
    "data:build": "tsx scripts/build-dataset.ts",
    "data:awareness": "tsx scripts/build-awareness.ts",
    "data:ct-awareness": "tsx scripts/merge-ct-awareness.ts",
    "data:nj-awareness": "tsx scripts/merge-nj-awareness.ts",
    "data:hv-parkways": "tsx scripts/merge-hv-parkways.ts",
    "data:pipeline-status": "tsx scripts/pipeline-status.ts",
    "data:build-unified": "tsx scripts/build-unified-awareness.ts",
    "data:enrich-parkway-heights": "tsx scripts/enrich-parkway-heights.ts",
    "data:apply-researched-heights": "tsx scripts/apply-researched-heights.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "^0.37.1",
    "fast-xml-parser": "^5.3",
    "prettier": "^3.9.6",
    "tsx": "^4.20",
    "typescript": "^5.9"
  }
}
